<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Shadowstep - Configurable</name>
    <modid>ShadowstepConfigurable</modid>
    <description>Adjust Shadowstep distances and travel speed in Mod Settings.</description>
    <author>oOCamilleOo</author>
    <version>0.1.1-dev</version>
    <created_on>2026-10-01</created_on>
  </info>
  <supports>
    <game>The Blood of Dawnwalker</game>
    <requires>UE4SS with Lua 5.4, native hooks, game-thread delayed actions and cancellation</requires>
    <optional>Dawnwalker Mod Menu 1.0.6 or later for in-game settings and live Apply</optional>
  </supports>
</mod>
